<mxfile host="app.diagrams.net" modified="2026-11-13T22:30:00.000Z" agent="drawio" version="24.0.0">
  <diagram id="arquitectura-pong" name="Arquitectura Pong LAN">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="vlan10" value="VLAN 10 - SERVIDORES (192.168.1.0/26)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="vlan20" value="VLAN 20 - JUGADORES (192.168.1.64/26)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="40" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="pc1" value="PC1 - Servidor del juego&#10;Jugador 1 (I, C o D)&#10;192.168.1.2&#10;DF1 + DF2 + DF3&#10;(marcador y turnos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="srv1" value="SRV1 - Servicios de red&#10;192.168.1.3&#10;DHCP, DNS, FTP, Web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pc2" value="PC2 - Cliente del juego&#10;Jugador 2 (I, C o D)&#10;192.168.1.66&#10;envia su jugada y&#10;muestra el estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="110" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sw1" value="SW1&#10;VLAN 10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="130" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sw2" value="SW2&#10;VLAN 20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="130" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="R1 (router-on-a-stick)&#10;Gi0/0.10 y Gi0/0.20&#10;inter-VLAN + helper-address" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="360" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="pc1" target="sw1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sw1" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="r1" target="sw2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sw2" target="pc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="pc1" target="srv1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="msg1" value="1. Conexión: PC2 -&gt; PC1 (socket TCP, puerto 5555)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="msg2" value="2. Petición de jugada: PC1 -&gt; PC2 («es tu turno: envía tu jugada: I, C o D»)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="485" width="500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="msg3" value="3. Jugada: PC2 -&gt; PC1 (jugada = 'C')" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="360" height="25" as="geometry" />
        </mxCell>
        <mxCell id="msg4" value="4. Estado del juego: PC1 -&gt; PC2 (turno, marcadores y barras, o aviso de jugada inválida)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="535" width="520" height="25" as="geometry" />
        </mxCell>
        <mxCell id="msg5" value="5. Fin de la partida: PC1 -&gt; PC2 («Gana el Jugador 1. Marcador: 5 - 3»)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="560" width="460" height="25" as="geometry" />
        </mxCell>
        <mxCell id="nota" value="La logica del juego (DF1/DF2/DF3) vive en el servidor (PC1). El cliente (PC2) solo envia su jugada y muestra el estado que recibe, asi el estado no se desincroniza. Gana quien llegue a 5 puntos (DF3); con 4-4 la partida sigue." style="text;html=1;fontSize=11;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="610" width="620" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
